{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Warning"
    }
  },
  "ConnectionStrings": {
    "CockroachDB": "Host=localhost;Port=26257;Database=defaultdb;Username=root;SSL Mode=Disable;"
  },
  "CockroachDB": {
    "Retry": {
      "MaxRetries": 50,
      "DelayMs": 10,
      "Multiplier": 1.5,
      "MaxDelayMs": 500,
      "JitterMs": 10
    },
    // tag::region-config[]
    // Allowed regions for InRegion(...) writes. No DefaultRegion is set, so the
    // pipeline stays region-agnostic until a caller explicitly scopes a region.
    "Region": {
      "Validate": true,
      "Allowed": [ "us-east1", "us-west1", "europe-west1" ]
    }
    // end::region-config[]
    ,
    // tag::mr-check-usage[]
    // Startup multi-region check: compares [GlobalTable]/[RegionalByRow]/[CrdbRegion]
    // against the live schema. none | warn | validate; default "warn" (a contradiction
    // fails startup even in warn). On by default once a context is registered with
    // AddCockroachDBDbContextFactory<T>()/AddCockroachDBDbContext<T>(); set "none" to disable.
    "MultiRegion": {
      "Mode": "warn"
    }
    // end::mr-check-usage[]
  }
}
