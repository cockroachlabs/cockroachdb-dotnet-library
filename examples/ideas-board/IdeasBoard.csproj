<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>IdeasBoard</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CockroachDB.DotNet.Core" Version="0.2.1" />
    <PackageReference Include="CockroachDB.DotNet.EntityFramework" Version="0.2.1" />
    <PackageReference Include="CockroachDB.DotNet.Cdc" Version="0.2.1" />
    <!-- Vector / semantic search (AddCockroachDBAI, CockroachDBVectorStore). -->
    <PackageReference Include="CockroachDB.DotNet.AI" Version="0.2.1" />
    <!-- CockroachDBConcurrencyRunner lives in the Testing package. -->
    <PackageReference Include="CockroachDB.DotNet.Testing" Version="0.2.1" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The test project lives under tests/; keep its sources out of the app compile. -->
  <ItemGroup>
    <Compile Remove="tests/**/*.cs" />
  </ItemGroup>

</Project>
