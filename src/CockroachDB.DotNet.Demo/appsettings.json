{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "CockroachDB": "Host=localhost;Port=26257;Database=defaultdb;Username=root;SSL Mode=Disable;"
  },
  "CockroachDB": {
    "Retry": {
      "MaxRetries": 3,
      "DelayMs": 100,
      "Multiplier": 2.0,
      "MaxDelayMs": 5000,
      "JitterMs": 50
    },
    "Region": {
      "DefaultRegion": "us-east1",
      "Validate": false,
      "Allowed": [],
      "Resolver": "Context",
      "HeaderName": "X-CockroachDB-Region"
    },
    "Metrics": {
      "Enabled": true
    },
    "CircuitBreaker": {
      "FailureThreshold": 5,
      "DurationOfBreakSeconds": 30,
      "SamplingDurationSeconds": 60
    }
  }
}
